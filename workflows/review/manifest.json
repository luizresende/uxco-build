{
  "id": "uxco-review",
  "version": 1,
  "mode": "READ",
  "description": "Review formal. O manifesto declara fases, contexto, artefatos e gates. O validador em scripts/chain.mjs aplica os gates. Outro comando reusa o mesmo formato: outro manifesto, o mesmo validador, outro slash command.",
  "always": ["CLAUDE.md"],
  "command": ".claude/commands/uxco-review.md",
  "agent": ".claude/agents/review-step.md",
  "artifactsDir": ".review-runs",
  "reportTemplate": "templates/reports/design-review.md",
  "orchestrator": {
    "loads": [
      "CLAUDE.md",
      ".claude/commands/uxco-review.md",
      "workflows/review/manifest.json",
      ".claude/agents/review-step.md"
    ],
    "conditional": [
      {
        "path": "docs/constitution/knowledge-routing.md",
        "when": "natural-language-route"
      }
    ]
  },
  "gates": [
    "scope-resolved",
    "paper-source",
    "context-gate",
    "evidence-layers",
    "single-cycle",
    "critique-record",
    "one-diagnosis",
    "qa-vs-design",
    "report-contract"
  ],
  "steps": [
    {
      "id": "scope",
      "prompt": "workflows/review/steps/scope.md",
      "when": "always",
      "context": [
        { "path": "docs/constitution/anti-patterns.md" },
        { "path": "docs/constitution/identity-and-mission.md" },
        { "path": "standards/design-output-format.md" }
      ],
      "input": [],
      "output": "scope.json",
      "schema": "workflows/review/schemas/scope.json",
      "gate": ["scope-resolved"],
      "touchesPaper": false,
      "stages": ["Receive review request", "Detect scope"],
      "marker": null
    },
    {
      "id": "inspect",
      "prompt": "workflows/review/steps/inspect.md",
      "when": "canvas",
      "context": [
        { "path": "docs/constitution/canvas-safety.md" },
        { "path": "docs/architecture.md" },
        { "path": "experiments/paper-mcp/smoke-test.md" },
        { "path": "standards/accessibility-baseline.md" }
      ],
      "input": ["scope.json"],
      "output": "inspect.json",
      "schema": "workflows/review/schemas/inspect.json",
      "gate": ["paper-source"],
      "touchesPaper": true,
      "stages": ["Inspect Paper"],
      "marker": null
    },
    {
      "id": "ground",
      "prompt": "workflows/review/steps/ground.md",
      "when": "always",
      "context": [
        { "path": "docs/constitution/context-protocol.md" },
        { "path": "docs/constitution/anti-patterns.md" },
        { "path": "skills/product-context/SKILL.md" },
        { "path": "standards/product-context-brief.md" }
      ],
      "input": ["scope.json", "inspect.json"],
      "output": "ground.json",
      "schema": "workflows/review/schemas/ground.json",
      "gate": ["context-gate"],
      "touchesPaper": false,
      "stages": ["Load project context", "Build Context Brief"],
      "marker": null
    },
    {
      "id": "analyze",
      "prompt": "workflows/review/steps/analyze.md",
      "when": "always",
      "context": [
        { "path": "docs/constitution/operating-principles.md" },
        { "path": "docs/constitution/anti-patterns.md" },
        { "path": "skills/design-critique/SKILL.md" },
        { "path": "skills/interaction-design/SKILL.md", "when": "flow" },
        { "path": "standards/critique-framework.md" },
        { "path": "standards/severity-framework.md" },
        { "path": "standards/design-output-format.md" },
        { "path": "standards/accessibility-baseline.md" },
        { "path": "standards/uxco-design-principles.md" }
      ],
      "input": ["scope.json", "inspect.json", "ground.json"],
      "output": "analyze.json",
      "schema": "workflows/review/schemas/analyze.json",
      "gate": ["evidence-layers"],
      "touchesPaper": false,
      "stages": [
        "Run Design Critique",
        "Run Interaction Design when relevant",
        "Normalize findings",
        "Classify severity",
        "Assign confidence",
        "Deduplicate findings",
        "Prioritize issues"
      ],
      "marker": "INITIAL_ANALYSIS"
    },
    {
      "id": "challenge",
      "prompt": "workflows/review/steps/challenge.md",
      "when": "always",
      "context": [
        { "path": "docs/constitution/operating-principles.md" },
        { "path": "docs/constitution/anti-patterns.md" },
        { "path": "agents/design-critic.md" },
        { "path": "standards/adversarial-quality.md" }
      ],
      "input": ["scope.json", "ground.json", "analyze.json"],
      "output": "challenge.json",
      "schema": "workflows/review/schemas/challenge.json",
      "gate": ["single-cycle", "critique-record"],
      "touchesPaper": false,
      "stages": ["Challenge the diagnosis"],
      "marker": "ADVERSARIAL_REVIEW"
    },
    {
      "id": "revise",
      "prompt": "workflows/review/steps/revise.md",
      "when": "always",
      "context": [
        { "path": "standards/adversarial-quality.md" },
        { "path": "standards/severity-framework.md" },
        { "path": "standards/critique-framework.md" }
      ],
      "input": ["analyze.json", "challenge.json"],
      "output": "revise.json",
      "schema": "workflows/review/schemas/revise.json",
      "gate": ["single-cycle", "one-diagnosis"],
      "touchesPaper": false,
      "stages": ["Revise the diagnosis"],
      "marker": "REVISION"
    },
    {
      "id": "close",
      "prompt": "workflows/review/steps/close.md",
      "when": "always",
      "context": [
        { "path": "docs/constitution/quality-gate.md" },
        { "path": "docs/constitution/decision-framework.md" },
        { "path": "docs/constitution/identity-and-mission.md" },
        { "path": "agents/design-qa.md" },
        { "path": "standards/adversarial-quality.md" },
        { "path": "standards/quality-framework.md" },
        { "path": "standards/critique-framework.md" },
        { "path": "templates/reports/design-review.md" }
      ],
      "input": ["scope.json", "inspect.json", "ground.json", "analyze.json", "challenge.json", "revise.json"],
      "output": "close.json",
      "schema": "workflows/review/schemas/close.json",
      "gate": ["single-cycle", "qa-vs-design", "report-contract"],
      "touchesPaper": false,
      "stages": ["Audit review quality", "Generate report", "Present next steps"],
      "marker": "FINAL_QA"
    }
  ]
}
