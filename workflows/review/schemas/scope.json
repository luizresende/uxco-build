{
  "type": "object",
  "additionalProperties": false,
  "required": ["step", "status", "haltReason", "scope", "artifactKind", "needsCanvas", "needsFlowSkill", "openQuestion"],
  "properties": {
    "step": { "const": "scope" },
    "status": { "enum": ["resolved", "halt"] },
    "haltReason": { "nullable": true, "enum": ["unresolved-scope", "no-artifact"] },
    "artifactKind": { "enum": ["canvas", "text", "image", "mixed", "none"] },
    "needsCanvas": { "type": "boolean" },
    "needsFlowSkill": { "type": "boolean" },
    "openQuestion": {
      "nullable": true,
      "type": "object",
      "additionalProperties": false,
      "required": ["blocking", "text"],
      "properties": {
        "blocking": { "type": "boolean" },
        "text": { "type": "string" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "source", "includes", "confidence", "ambiguities", "basis"],
      "properties": {
        "type": { "enum": ["screen", "frame", "selection", "frame-set", "flow", "UNKNOWN"] },
        "name": { "type": "string" },
        "source": { "enum": ["explicit", "selection", "inferred", "UNKNOWN"] },
        "includes": { "type": "array", "items": { "type": "string" } },
        "confidence": { "enum": ["High", "Medium", "Low"] },
        "ambiguities": { "type": "array", "items": { "type": "string" } },
        "basis": { "type": "string" }
      }
    }
  }
}
